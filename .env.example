# Copy this file to ".env" (same folder as app.py), edit the values in Notepad, restart the app.
# The app reads .env by itself at start-up; .env is in .gitignore, so never put real values in THIS file.
# - one NAME=value per line, no spaces needed around "="; lines starting with # are comments
# - put a value in quotes if it contains " #" or starts/ends with a space:  PBX_WEB_PASS="my #pass"
# - a variable that is already set in the system wins over .env (to override one without editing it)
# - `python tools/check_env.py` shows what was understood (passwords are hidden)
# - PBX_DOTENV=0 (set in the system, not here) makes the app ignore .env

# --- Issabel web panel as the PBX source (no SSH / AMI needed) ---
PBX_WEB_HOST=https://192.168.1.100
PBX_WEB_USER=monitor
PBX_WEB_PASS=change-me
# Seconds between syncs (default 30, minimum 15)
PBX_SYNC_INTERVAL=30
# Issabel ships a self-signed certificate; keep False unless it has a real one
PBX_VERIFY_SSL=False

# --- optional ---
# PBX_SOURCE=web            # auto (default): AMI if configured, otherwise the web panel
# PBX_WEB_TIMEOUT=10        # seconds per HTTP request
# PBX_WEB_LOGIN_PATH=/index.php
# PBX_WEB_PEERS_PATH=/index.php?menu=control_panel   # default: Operator Panel (registered + IP, no latency)
#                                                    # old: /index.php?menu=asterisk_info&rawmode=yes
# PBX_SLOW_MS=150           # online phones at or above this latency get the yellow badge
# PBX_STATUS_STALE_MINUTES=10

# --- phone outage log (Log.txt + the PhoneOutage table) ---
# PBX_OUTAGE_MONITOR=1          # 0 turns the outage tracking off
# PBX_OUTAGE_CONFIRM_SYNCS=2    # a phone must stay offline this many syncs in a row (2 x 30 s = about a minute)
# PBX_OUTAGE_KINDS=staff,room   # which extension kinds are watched (also: pending)
# PBX_OUTAGE_LOG=               # default: logs/Log.txt next to the app
# PBX_OUTAGE_KEEP_DAYS=180      # finished outages older than this are deleted automatically (0 = keep everything)

# --- outage alerts in the browser (Windows notifications) ---
# PBX_ALERTS_ENABLED=1          # 0 hides the bell and stops creating alert events
# PBX_ALERT_SUMMARY_THRESHOLD=5 # more phones than this going offline in one sync -> ONE summary alert
# PBX_ALERT_ON_RECOVERY=1       # quiet alert when a phone comes back; 0 = recoveries only go to Log.txt and the report

# Copy this file to ".env" (same folder as app.py), edit the values in Notepad, restart the app.
# The app reads .env by itself at start-up; .env is in .gitignore, so never put real values in THIS file.
# - one NAME=value per line, no spaces needed around "="; lines starting with # are comments
# - put a value in quotes if it contains " #" or starts/ends with a space:  PBX_WEB_PASS="my #pass"
# - a variable that is already set in the system wins over .env (to override one without editing it)
# - `python tools/check_env.py` shows what was understood (passwords are hidden)
# - PBX_DOTENV=0 (set in the system, not here) makes the app ignore .env

# --- Issabel web panel as the PBX source (no SSH / AMI needed) ---
PBX_WEB_HOST=https://192.168.1.100
PBX_WEB_USER=monitor
PBX_WEB_PASS=change-me
# Seconds between syncs (default 30, minimum 15)
PBX_SYNC_INTERVAL=30
# Issabel ships a self-signed certificate; keep False unless it has a real one
PBX_VERIFY_SSL=False

# --- optional ---
# PBX_SOURCE=web            # auto (default): AMI if configured, otherwise the web panel
# PBX_WEB_TIMEOUT=10        # seconds per HTTP request
# PBX_WEB_LOGIN_PATH=/index.php
# PBX_WEB_PEERS_PATH=/index.php?menu=control_panel   # default: Operator Panel (registered + IP, no latency)
#                                                    # old: /index.php?menu=asterisk_info&rawmode=yes
# PBX_SLOW_MS=150           # online phones at or above this latency get the yellow badge
# PBX_STATUS_STALE_MINUTES=10
# PBX_UA_BATCH=60           # AMI only: how many phones' User-Agent are read per sync
# PBX_SYNC_AUTOSTART=1      # 0 = no background sync (only the "sync now" button)

# --- AMI (optional; used instead of the web panel when set, and by the newer PBX features) ---
# PBX_AMI_HOST=192.168.1.100
# PBX_AMI_PORT=5038
# PBX_AMI_USER=hotelapp
# PBX_AMI_SECRET=<AMI_SECRET>
# PBX_AMI_TIMEOUT=5         # seconds per answer
# PBX_AMI_AUTH=md5          # md5 (default: the secret never crosses the network) or plain
# PBX_AMI_MAX_SECONDS=30    # ceiling for one whole AMI session
# PBX_SIP_DRIVER=auto       # auto (default, detected once) / sip / pjsip

# --- call report (CDR): read-only MySQL user on the PBX, see DEPLOYMENT.md section 11 ---
# PBX_CDR_HOST=192.168.1.100
# PBX_CDR_PORT=3306
# PBX_CDR_USER=hotel_cdr
# PBX_CDR_PASS=<CDR_PASSWORD>
# PBX_CDR_DB=asteriskcdrdb
# PBX_CDR_TIMEOUT=5
# PBX_CDR_MAX_DAYS=31                    # longest date range of the call report
# PBX_CDR_MAX_ROWS=5000                  # newest rows reachable by paging
# PBX_CDR_EXPORT_ROWS=20000              # rows in one CSV export
# PBX_CDR_RECEPTION=100,101              # reception extensions, for the "reception answer rate" card
# PBX_CDR_INBOUND_CONTEXTS=from-trunk,from-pstn,from-did-direct,ext-did   # dcontext of inbound calls
# PBX_CDR_INTERNAL_PATTERN=^[0-9]{2,5}$  # a dst that matches is an internal call
# PBX_TIMEZONE=                          # time zone of calldate on the PBX (default: APP_TIMEZONE)

# --- day / night mode (Call Flow Control); switching is OFF until tested, see DEPLOYMENT.md section 11-11 ---
# PBX_DAYNIGHT_ALLOWED=0             # Call Flow indexes that may be switched from the app (white list); empty = none
# PBX_DAYNIGHT_WRITE_ENABLED=0       # 1 = allow switching (after the safe test)
# PBX_AMI_WRITE_USER=hotelapp_dn     # separate AMI user, used only for the switch
# PBX_AMI_WRITE_SECRET=<AMI_WRITE_SECRET>
# PBX_DAYNIGHT_WRITE_METHOD=setvar   # setvar (needs write=call) or dbput (needs write=system)
# PBX_DAYNIGHT_DEVSTATE=1            # also set Custom:DAYNIGHT<n> for the BLF lamps
# PBX_DAYNIGHT_LABELS=0:پذیرش         # names when the daynight table cannot be read
# PBX_DAYNIGHT_TABLE=asterisk.daynight   # or a view without the password row, e.g. hotelapp_ro.daynight

# --- call recordings (played / downloaded through the app from Issabel's Monitoring module) ---
# PBX_REC_WEB_USER=recordings          # a panel user that may open ONLY "Monitoring" (default: PBX_WEB_USER)
# PBX_REC_WEB_PASS=<REC_WEB_PASSWORD>
# PBX_REC_DOWNLOAD_PATH=/index.php?menu=monitoring&action=download&id={uniqueid}&namefile={file}&rawmode=yes
# PBX_REC_DOWNLOADS_PER_HOUR=20        # per user; 0 = no limit
# PBX_REC_MAX_MB=300                   # largest file streamed

# --- snapshots (DND / forward, health, ...): one read of the PBX per this many seconds (minimum 30) ---
# PBX_SNAPSHOT_TTL=120
# `python tools/check_pbx.py` tests every connection above (secrets are never printed)

# --- extensions on Issabel that are not in the directory ---
# PBX_AUTO_CREATE=1         # 1 (default): the sync creates them hidden (room / pending); 0: only listed on "compare with Issabel"

# --- Issabel server health (page + alerts in the bell) ---
# PBX_WEB_HEALTH_PATHS=/index.php?menu=dashboard   # panel page(s) with CPU / memory / disk / services, comma separated
# PBX_HEALTH_ALERTS=1           # 0 = show the page only, no alerts
# PBX_HEALTH_DISK_WARN=85       # alert at or above this % of a partition ...
# PBX_HEALTH_DISK_CLEAR=80      # ... and end it below this %
# PBX_HEALTH_CPU_WARN=90
# PBX_HEALTH_CPU_CLEAR=75
# PBX_HEALTH_CPU_SAMPLES=3      # readings in a row above PBX_HEALTH_CPU_WARN before the CPU alert

# --- phone outage log (Log.txt + the PhoneOutage table) ---
# PBX_OUTAGE_MONITOR=1          # 0 turns the outage tracking off
# PBX_OUTAGE_CONFIRM_SYNCS=2    # a phone must stay offline this many syncs in a row (2 x 30 s = about a minute)
# PBX_OUTAGE_KINDS=staff,room   # which extension kinds are watched (also: pending)
# PBX_OUTAGE_LOG=               # default: logs/Log.txt next to the app
# PBX_OUTAGE_KEEP_DAYS=180      # finished outages older than this are deleted automatically (0 = keep everything)

# --- outage alerts in the browser (Windows notifications) ---
# PBX_ALERTS_ENABLED=1          # 0 hides the bell and stops creating alert events
# PBX_ALERT_SUMMARY_THRESHOLD=5 # more phones than this going offline in one sync -> ONE summary alert
# PBX_ALERT_ON_RECOVERY=1       # quiet alert when a phone comes back; 0 = recoveries only go to Log.txt and the report

# --- sign-in lockout (see docs/RBAC.md) ---
# LOGIN_LOCK_ATTEMPTS=5        # wrong passwords for one username before it is locked; 0 = off
# LOGIN_LOCK_MINUTES=15        # how long the lock lasts (also the window the attempts are counted in)

+        with self.assertRaises(PBXWebLoginRejected):
+            scraper.fetch_peer_states()
+        scraper._rejected_at -= pbx_sync.LOGIN_RETRY_SECONDS + 1
+        with self.assertRaises(PBXWebLoginRejected):
